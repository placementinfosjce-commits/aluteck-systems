generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id              String   @id @default(cuid())
  fullName        String
  phone           String
  email           String
  city            String
  requirements    String
  productSeries   String?
  source          String   @default("Website Form")
  status          String   @default("New") // New, Contacted, Qualified, Quotation Sent, Converted, Closed
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Complaint {
  id              String   @id @default(cuid())
  referenceNumber String   @unique
  fullName        String
  phone           String
  email           String
  city            String
  productSeries   String?
  projectRef      String?
  complaintText   String
  status          String   @default("Submitted") // Submitted, Under Review, In Progress, Resolved, Closed
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CatalogueDocument {
  id          String   @id @default(cuid())
  productSlug String
  title       String
  fileUrl     String
  fileSize    String?
  fileType    String   @default("PDF")
  createdAt   DateTime @default(now())
}

model WebsiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}
